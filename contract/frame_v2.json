{
  "name": "orin-dualos frame_v2",
  "size_bytes": 128,
  "byte_order": "little-endian, explicit pack/unpack",
  "clock": "uint64 nanoseconds, sender-local monotonic",
  "crc": {
    "algo": "crc32c (Castagnoli, reflected, poly 0x1EDC6F41)",
    "covers": ["[0,88)", "[96,128)"],
    "vector": "crc32c('123456789') == 0xE3069283"
  },
  "fields": [
    {"name": "seq",        "offset": 0,  "size": 8, "type": "u64", "desc": "per-direction monotonic"},
    {"name": "ver",        "offset": 8,  "size": 2, "type": "u16", "desc": "0x0002"},
    {"name": "type",       "offset": 10, "size": 1, "type": "u8",  "desc": "RELEASE|CANCEL|COMPLETE|PING|PONG|KICK"},
    {"name": "flags",      "offset": 11, "size": 1, "type": "u8", "desc": "bit0 deadline_miss bit1 degraded bit2 warmup bit3 last_of_run"},
    {"name": "task_id",    "offset": 12, "size": 2, "type": "u16", "desc": "0=null 1=chain 2=det30 3=synth 4=triggered"},
    {"name": "rsv",        "offset": 14, "size": 2, "type": "u16", "desc": "zero on send; wire CRC-covered but unpack-normalized"},
    {"name": "t_release",  "offset": 16, "size": 8, "type": "u64", "src": "QNX", "desc": "epoch + k*T, arithmetic, clock-free"},
    {"name": "t_tx",       "offset": 24, "size": 8, "type": "u64", "src": "QNX", "desc": "written to socket"},
    {"name": "t_deadline", "offset": 32, "size": 8, "type": "u64", "src": "QNX", "desc": "release + budget"},
    {"name": "t_rx",       "offset": 40, "size": 8, "type": "u64", "src": "Linux", "desc": "read off socket"},
    {"name": "t_exec",     "offset": 48, "size": 8, "type": "u64", "src": "Linux", "desc": "handed to executor thread"},
    {"name": "t_pre_end",  "offset": 56, "size": 8, "type": "u64", "src": "Linux", "desc": "input staging done"},
    {"name": "t_infer_end","offset": 64, "size": 8, "type": "u64", "src": "Linux", "desc": "last sync returned"},
    {"name": "t_post_end", "offset": 72, "size": 8, "type": "u64", "src": "Linux", "desc": "outputs staged"},
    {"name": "t_rx_q",     "offset": 80, "size": 8, "type": "u64", "src": "QNX", "desc": "COMPLETE read, COMPLETE frames only"},
    {"name": "err",        "offset": 88, "size": 4, "type": "u32", "desc": "ok|queue_overflow|engine_fail|cancelled"},
    {"name": "crc",        "offset": 92, "size": 4, "type": "u32", "desc": "crc32c over [0,88)+[96,128)"},
    {"name": "payload",    "offset": 96, "size": 32, "type": "u8[32]", "desc": "task-specific: chain output digest / workload params"}
  ],
  "segments": {
    "identity": "sum of segments == t_rx_q - t_release (telescoping, exact)",
    "list": [
      {"name": "T_sched",    "from": "t_release", "to": "t_tx"},
      {"name": "T_ipc_up",   "from": "t_tx",      "to": "t_rx"},
      {"name": "T_queue",    "from": "t_rx",      "to": "t_exec"},
      {"name": "T_pre",      "from": "t_exec",    "to": "t_pre_end"},
      {"name": "T_infer",    "from": "t_pre_end", "to": "t_infer_end"},
      {"name": "T_post",     "from": "t_infer_end", "to": "t_post_end"},
      {"name": "T_ipc_down", "from": "t_post_end", "to": "t_rx_q"}
    ]
  },
  "frame_types": {
    "RELEASE": 1, "CANCEL": 2, "COMPLETE": 3, "PING": 4, "PONG": 5, "KICK": 7
  }
}
